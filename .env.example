# ==============================================================================
# SafeDig AI Map QA & Validation Console - Environment Configuration
# Copy this file to '.env' and update variables as appropriate for your environment.
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Safety Mode: When True, enforces zero escaped hazards and deterministic policy evaluation
SAFE_MODE=True

# Processing Workers: Concurrency for vector analysis and raster processing
MAX_WORKERS=4

# High-Fidelity Rendering DPI (300 DPI recommended for safety-critical inspection)
DEFAULT_DPI=300

# Directory for QA Job Outputs, Crop Evidence, and Audit Packages
OUTPUT_DIR=qa_output

# Database URL (SQLite with aiosqlite for async local persistence)
DATABASE_URL=sqlite+aiosqlite:///safedig.db

# LLM Advisory Copilot Configuration (Advisory Only - Zero Validation Authority)
ENABLE_LLM_ADVISORY=True
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen2.5:latest
LLM_TIMEOUT_SEC=10.0

# Optional Cloud LLM Keys (if not using local Ollama)
# ANTHROPIC_API_KEY=your-anthropic-key-here
# OPENAI_API_KEY=your-openai-key-here
